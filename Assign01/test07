import torch
import torch.nn.functional as F

# 为了隔离训练机制，这里暂时直接把 logits 当作可训练参数。
logits = torch.nn.Parameter(
    torch.tensor([2.0, 1.0, 0.0])
)

# 正确答案是位置 1，也就是第二个候选 token。
target = torch.tensor([1])

optimizer = torch.optim.SGD(
    [logits],
    lr=0.1,
)

for step in range(6):
    # CrossEntropyLoss 要求 batch 维度：
    # [3] -> [1, 3]
    batched_logits = logits.unsqueeze(0)

    loss = F.cross_entropy(
        batched_logits,
        target,
    )

    probabilities = torch.softmax(
        logits.detach(),
        dim=0,
    )

    print(
        f"step={step}",
        f"loss={loss.item():.4f}",
        f"logits={logits.detach().tolist()}",
        f"probabilities={probabilities.tolist()}",
    )

    # 清除上一次迭代保存的梯度。
    optimizer.zero_grad()

    # 计算 loss 对 logits 的梯度。
    loss.backward()

    # 执行 logits -= learning_rate * logits.grad
    optimizer.step()